# Copia este archivo como .env y llena los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Clave para firmar las sesiones. Pon una cadena larga y aleatoria.
SECRET_KEY=

# Conexión a MySQL local: usuario root sin contraseña, base ual_optometria
DATABASE_URL=mysql+pymysql://root:@localhost/ual_optometria

# Contraseñas de los usuarios que se crean la primera vez que arranca el servidor
ADMIN_PASSWORD=
COORDINADOR_PASSWORD=
OPTOMETRISTA_PASSWORD=
